# A typical first-draft Python service image
FROM python
ENV API_KEY=sk-live-1234567890 \
    APP_ENV=production
WORKDIR app
COPY . .
RUN apt-get update
RUN apt-get install -y build-essential curl
RUN curl -fsSL https://example.com/install.sh | sh
RUN pip install -r requirements.txt
ADD config.yaml /etc/app/config.yaml
EXPOSE 8000 22
CMD python -m app
